// GATK per-sample pipeline for Aviti reads, on one machine.
// Without a profile the tools run from the PATH; -profile docker runs them in containers with the same versions.

params {
    samplename = null
    fastq1 = null
    fastq2 = null
    outdir = 'results'

    // Ensembl GRCh38 primary assembly with its .fai, .dict and bwa index
    reference = null
    reference_fai = null
    reference_dict = null
    reference_ann = null
    reference_bwt = null
    reference_pac = null
    reference_amb = null
    reference_sa = null

    picard = null              // picard.jar of Picard 2.26.0
    intervals = "${projectDir}/../intervals.list"

    genomicsdb_dir = null      // a new, empty folder: GENOMICSDBIMPORT adds the sample to any store it finds there
    mosdepth_window = 500
    tmp_dir = '/tmp'
    markdup_bam_dir = null     // a folder for a copy of the duplicate-marked BAM; null as in the cohort runs

    // docker profile: inputs, outputs, picard.jar and tmp_dir under data_dir
    data_dir = null
    container_memory = '500g'
}

// profiles before process: a withName block in a later profile would replace the cpus and memory below
profiles {
    docker {
        docker.enabled = true
        // the last --memory wins over the one Nextflow sets from the task memory
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${params.data_dir}:${params.data_dir} --memory ${params.container_memory}"
        process {
            withName:BWAMEM_SORT {
                container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:a34558545ae1413d94bde4578787ebef08027945-0'
            }
            withName:'INDEXMARKDUPBAM|SAMTOOLS_STATS' {
                container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_0'
            }
            withName:MOSDEPTH {
                container = 'quay.io/biocontainers/mosdepth:0.3.6--hd299d5a_0'
            }
            withName:'MARKDUPLICATES|PICARD_ALIGNMENT_METRICS|HAPLOTYPECALLER|INDEXGVCF|GENOMICSDBIMPORT' {
                container = 'broadinstitute/gatk:4.5.0.0'
            }
        }
    }
}

// cpus and memory as in the runs: the modules write them into -Xmx and the thread options
process {
    withName:BWAMEM_SORT {
        cpus = 70
        memory = '120.GB'
        time = '12.h'
    }
    withName:MARKDUPLICATES {
        cpus = 60
        memory = '100.GB'
        time = '8.h'
    }
    withName:INDEXMARKDUPBAM {
        cpus = 16
        memory = '16.GB'
        time = '2.h'
    }
    withName:PICARD_ALIGNMENT_METRICS {
        cpus = 50
        memory = '60.GB'
        time = '20.h'
    }
    withName:SAMTOOLS_STATS {
        cpus = 8
        memory = '20.GB'
        time = '4.h'
    }
    withName:MOSDEPTH {
        cpus = 8
        memory = '20.GB'
        time = '3.h'
    }
    withName:HAPLOTYPECALLER {
        cpus = 5
        memory = '12.GB'
        time = '24.h'
    }
    withName:INDEXGVCF {
        cpus = 2
        memory = '2.GB'
        time = '2.h'
    }
    withName:GENOMICSDBIMPORT {
        cpus = 8
        memory = '16.GB'
        time = '12.h'
    }
}

executor {
    name = 'local'
    cpus = 70
    memory = '155.GB'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_report.html"
    overwrite = true
}
// the 33 trace columns of the cohort runs
trace {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_dag.svg"
    overwrite = true
}
