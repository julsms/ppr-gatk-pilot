// Joint genotyping of the Illumina GenomicsDB stores, on one machine.
// Without a profile gatk, java and picard.jar run from the machine; -profile docker runs the GATK steps in the GATK image.

params {
    genomicsdb_dir = null              // the 66 stores <interval>_genomicsdb (../genomicsdb_import, platform illumina)
    samplename_joint = null            // a name for the run, printed only
    intervals = "${projectDir}/../intervals.list"
    outdir = 'results_joint_analysis'

    reference = null                   // Ensembl GRCh38 primary assembly with .fai and .dict
    reference_fai = null
    reference_dict = null
    picard = null                      // picard.jar of Picard 2.26.0 (MergeVcfs)
    tmp_dir = '/tmp'                   // scratch folder of all modules (in the runs a fixed <server root>/tmp)

    // docker profile: inputs, outputs, tmp_dir and picard under data_dir
    data_dir = null
    container_memory = '500g'
}

profiles {
    docker {
        docker.enabled = true
        // the last --memory wins over the one Nextflow sets from the task memory
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${params.data_dir}:${params.data_dir} --memory ${params.container_memory}"
        process {
            withName:'GENOTYPEGVCFS_SPLIT|MERGE_INTERVAL_VCFS' {
                container = 'broadinstitute/gatk:4.5.0.0'
            }
        }
    }
}

// cpus and memory as in the runs: the modules write them into -Xmx and -XX:ParallelGCThreads
process {
    withName:GENOTYPEGVCFS_SPLIT {
        cpus = 4
        memory = '12.GB'
        time = '6.h'
        maxForks = 18
    }

    withName:MERGE_INTERVAL_VCFS {
        cpus = 60
        memory = '60.GB'
        time = '2.h'
    }
}

workDir = './work'

executor {
    name = 'local'
    cpus = 70
    memory = '140.GB'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

// keep work/: merged_vcf/ is a link into it
cleanup = false

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
