// GATK per-sample pipeline for Illumina reads, on one machine.
// Without a profile the tools run from the PATH; -profile docker runs them in containers with the same versions.

params {
    samplename = null
    fastq1 = null
    fastq2 = null
    outdir = 'results'

    // Ensembl GRCh38 primary assembly with its .fai, .dict and bwa index
    reference = null
    reference_fai = null
    reference_dict = null
    reference_ann = null
    reference_bwt = null
    reference_pac = null
    reference_amb = null
    reference_sa = null

    picard = null                       // picard.jar of Picard 2.26.0
    // known sites of BaseRecalibrator: the Broad hg38 v0 objects Homo_sapiens_assembly38.known_indels.vcf.gz and
    // Mills_and_1000G_gold_standard.indels.hg38.vcf.gz, with chr removed from the contig of the records on 1-22, X and Y
    // (records on other contigs keep chr, not a contig of the reference) and from all header contig lines.
    // md5 of the files that ran: known indels 970fb6e6292b2496c06d6b2e33d98ca7 (.tbi 020f11ee77cf2502b459b0302878e95c),
    // Mills 8ed7559397eb5df148d4e74bcd5db94b (.tbi 6ed514574ec14debefc74de2a27e8c1b)
    resources_knownindels = null
    resources_knownindels_tbi = null
    resources_mills = null
    resources_mills_tbi = null
    intervals = "${projectDir}/../intervals.list"

    genomicsdb_persistent_path = null   // a new, empty folder: GENOMICSDBIMPORT adds the sample to any store it finds there
    tmp_dir = '/tmp'
    genomicsdb_tmp_dir = '/tmp/genomics'
    stop_after_markdup = false

    // docker profile: inputs, outputs, picard.jar and tmp_dir under data_dir
    data_dir = null
    container_memory = '500g'
}

// profiles before process: a withName block in a later profile would replace the cpus and memory below
profiles {
    docker {
        docker.enabled = true
        // the last --memory wins over the one Nextflow sets from the task memory
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${params.data_dir}:${params.data_dir} --memory ${params.container_memory}"
        process {
            withName:BWAMEM_SORT {
                container = 'quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:a34558545ae1413d94bde4578787ebef08027945-0'
            }
            withName:'GATHERBAMFILES|INDEXBAMBQSR' {
                container = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_0'
            }
            withName:'MARKDUPLICATES|BUILDBAMINDEX|BASERECALIBRATOR|GATHERBQSRREPORTS|APPLYBQSR|HAPLOTYPECALLER|INDEXGVCF|GENOMICSDBIMPORT' {
                container = 'broadinstitute/gatk:4.5.0.0'
            }
        }
    }
}

// cpus and memory as in the runs: the modules write them into -Xmx, -XX:ParallelGCThreads and the thread options
process {
    withName:BWAMEM_SORT {
        cpus = 60
        memory = '60.GB'
        time = '6.h'
    }

    withName:MARKDUPLICATES {
        cpus = 50
        memory = '60.GB'
        time = '5.h'
    }

    withName:BUILDBAMINDEX {
        cpus = 8
        memory = '8.GB'
        time = '1.h'
    }

    withName:BASERECALIBRATOR {
        cpus = 4
        memory = '8.GB'
        time = '5.h'
        maxForks = 18
    }

    withName:GATHERBQSRREPORTS {
        cpus = 50
        memory = '40.GB'
        time = '2.h'
    }

    withName:APPLYBQSR {
        cpus = 4
        memory = '8.GB'
        time = '5.h'
        maxForks = 18
    }

    withName:GATHERBAMFILES {
        cpus = 50
        memory = '40.GB'
        time = '2.h'
    }

    withName:INDEXBAMBQSR {
        cpus = 50
        memory = '50.GB'
        time = '30.m'
    }

    withName:HAPLOTYPECALLER {
        cpus = 2
        memory = '5.GB'
        time = '9.h'
        maxForks = 30
    }

    withName:INDEXGVCF {
        cpus = 2
        memory = '5.GB'
        time = '10.h'
        maxForks = 30
    }

    withName:GENOMICSDBIMPORT {
        cpus = 2
        memory = '5.GB'
        time = '8.h'
        maxForks = 30
    }
}

workDir = './work'

executor {
    name = 'local'
    cpus = 70
    memory = '155.GB'
}

process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/${params.samplename}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
