// GenomicsDBImport of the gVCFs of all samples of one platform, on one machine.
// Without a profile gatk runs from the PATH; -profile docker runs it in the GATK image.

params {
    platform = null          // illumina or aviti
    samplesheet = null       // TSV with the columns sample and folder (see samplesheet.tsv)
    intervals = "${projectDir}/../intervals.list"
    genomicsdb_dir = null    // a new, empty folder
    outdir = 'results'
    tmp_dir = '/tmp'         // Illumina only

    // docker profile: gVCFs, genomicsdb_dir and tmp_dir under data_dir
    data_dir = null
    container_memory = '500g'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = "-u \$(id -u):\$(id -g) -v ${params.data_dir}:${params.data_dir} --memory ${params.container_memory}"
        process.container = 'broadinstitute/gatk:4.5.0.0'
    }
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
    // the GenomicsDBImport options are written in the module; cpus and memory only schedule the tasks
    withName:GENOMICSDBIMPORT_FROM_GVCFS {
        cpus = { params.platform == 'illumina' ? 60 : 8 }
        memory = { params.platform == 'illumina' ? '60 GB' : '16 GB' }
        time = '24.h'
        maxForks = 4
    }
}

executor {
    name = 'local'
    cpus = 64
    memory = '100 GB'
}

cleanup = false

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,container,cpus,time,memory,attempt,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes'
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}
