// The PPR pipeline on one machine: local executor and Docker. The inputs are params (see README.md).
params {
    // Input parameters
    reads = null            // paired-read glob; several pairs in the glob = several samples in one run
    sample_name = null      // optional: overrides the sample id taken from the file names (single-sample runs)
    outdir = null

    // Structural variant calling method selection
    vgcall = false
    pangenie = false
    both = false

    // Optional workflows
    run_deepvariant = false
    vcf_postprocessing = false

    // HPRC v1.1 graph and its haplotype index
    graph_gbz = null        // hprc-v1.1-mc-grch38.gbz
    graph_hapl = null       // hprc-v1.1-mc-grch38.hapl

    // GRCh38 with chr names, and its .fai
    reference_fasta = null
    reference_fai = null

    // Only for --vcf_postprocessing (GATK VQSR of the DeepVariant VCF; not used in the paper)
    reference_dict = null
    hapmap = null
    hapmap_tbi = null
    omni = null
    omni_tbi = null
    phase1 = null
    phase1_tbi = null
    dbsnp = null
    dbsnp_tbi = null
    mills = null
    mills_tbi = null

    // GPU option of the DeepVariant container
    docker_gpu_opts = "--gpus all"
}

// Process configuration
process {
    executor = 'local'

    // Default resources
    cpus = 4
    memory = 8.GB
    time = 2.h

    // Error handling
    errorStrategy = { task.exitStatus in [143, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries = 1

    // Process-specific resources
    withName: KMC_COUNT {
        container = 'quay.io/biocontainers/kmc:3.2.4--h5ca1c30_4'
        cpus = 70
        memory = 120.GB
        time = 4.h
    }

    withName: HAPLOTYPE_SAMPLING {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 70
        memory = 140.GB
        time = 5.h
    }

    withName: VG_GIRAFFE {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 70
        memory = 140.GB
        time = 8.h
    }

    withName: VG_PACK {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 40
        memory = 100.GB
        time = 8.h
    }

    withName: VG_CALL {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 70
        memory = 120.GB
        time = 8.h
    }

    withName: 'COMPRESS_INDEX_VCF|COMPRESS_INDEX_VCF_PANGENIE' {
        container = 'quay.io/biocontainers/htslib:1.19.1--h81da01d_1'
        cpus = 4
        memory = 8.GB
        time = 2.h
    }

    withName: VG_DECONSTRUCT {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 65
        memory = 140.GB
        time = 4.h
    }

    withName: VCFBUB_FILTER {
        container = 'quay.io/biocontainers/vcfbub:0.1.2--hc1c3326_1'
        cpus = 12
        memory = 32.GB
        time = 3.h
    }

    withName: VCFWAVE {
        container = 'quay.io/biocontainers/vcflib:1.0.15--h3fa9d83_1'
        cpus = 8
        memory = 32.GB
        time = 8.h
    }

    withName: PANGENIE_PREP {
        container = 'ppr/pangenie-callset:4.2.1'
        cpus = 4
        memory = 32.GB
        time = 6.h
    }

    withName: PANGENIE_BIALLELIC {
        container = 'ppr/pangenie-callset:4.2.1'
        cpus = 2
        memory = 16.GB
        time = 2.h
    }

    withName: PANGENIE_INDEX {
        container = 'mgibio/pangenie:v4.2.1-bookworm'
        cpus = 65
        memory = 140.GB
        time = 6.h
    }

    withName: PANGENIE_GENOTYPE {
        container = 'mgibio/pangenie:v4.2.1-bookworm'
        cpus = 65
        memory = 140.GB
        time = 4.h
    }

    // Small variants processes
    withName: VG_VIEW {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 50
        memory = 120.GB
        time = 4.h
    }

    withName: VG_INDEX_XG {
        container = 'quay.io/vgteam/vg:v1.52.0'
        cpus = 70
        memory = 100.GB
        time = 7.h
    }

    withName: VG_SURJECT {
        container = 'ppr/vg-samtools:1.52.0-1.17'
        cpus = 70
        memory = 100.GB
        time = 8.h
    }

    withName: DEEPVARIANT {
        container = 'google/deepvariant:1.9.0-gpu'
        cpus = 40
        memory = 90.GB
        time = 8.h
    }

    withName: 'FILTER_VARIANTS' {
        container = 'quay.io/biocontainers/bcftools:1.17--haef29d1_0'
        cpus = 2
        memory = 4.GB
        time = 2.h
    }

    withName: 'VARIANT_ANNOTATOR' {
        container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
        cpus = 4
        memory = 24.GB
        time = 4.h
    }

    withName: 'VARIANT_RECALIBRATOR_SNPS' {
        container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
        cpus = 4
        memory = 24.GB
        time = 6.h
    }

    withName: 'VARIANT_RECALIBRATOR_INDELS' {
        container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
        cpus = 4
        memory = 24.GB
        time = 6.h
    }

    withName: 'APPLY_VQSR' {
        container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
        cpus = 4
        memory = 24.GB
        time = 4.h
    }
}

// Docker configuration: graph and reference are staged task inputs, no bind mounts needed.
docker {
    enabled = true
    runOptions = "--user \$(id -u):\$(id -g)"
}

profiles {
    // A machine without a GPU: the CPU image of DeepVariant
    cpu {
        params.docker_gpu_opts = ""
        process {
            withName: 'DEEPVARIANT' {
                container = 'google/deepvariant:1.9.0'
            }
        }
    }
}

// Execution reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
